# ─── Apache / cPanel Configuration for 3D Anatomy Studio ──────────────────

# ─── Keamanan: berkas tersembunyi (mis. .admin_pass lama, .htadmin_pass), helper internal, dan skrip CLI tidak boleh diunduh
<FilesMatch "^(\..*|set-admin-pass\.php|_admin_auth\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_mime.c>
    # 3D GLTF / GLB models
    AddType model/gltf-binary .glb
    AddType model/gltf+json .gltf
    # JSON data
    AddType application/json .json
    # WebAssembly if needed
    AddType application/wasm .wasm
    # Images & SVG
    AddType image/svg+xml .svg .svgz
</IfModule>

<IfModule mod_headers.c>
    # Enable CORS for assets (needed for Three.js WebGL model loaders)
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization"

    # API admin berbasis password: jangan izinkan CORS lintas-asal
    <FilesMatch "^(db|updater)\.php$">
        Header unset Access-Control-Allow-Origin
        Header unset Access-Control-Allow-Methods
        Header unset Access-Control-Allow-Headers
    </FilesMatch>

    # Anti-cache for custom favicon
    <FilesMatch "custom-favicon\.png">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /3d-anatomy/

    # Allow direct access to existing files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Don't rewrite PHP API calls
    RewriteRule ^3d-anatomy/(db|updater)\.php - [L]
    RewriteRule ^(db|updater)\.php - [L]

    # Route everything else to index.html for SPA
    RewriteRule ^ index.html [L]
</IfModule>
